.idea/

# Private dev tools (sideload updater, live-log server, ngrok URL, dev notes). Debug builds use them when
# present; release builds never do. Never commit this folder. Back it up.
dev-local/

# Build outputs (dev APKs, Play bundles, R8 mapping): never versioned
dist/
*.apk
*.aab

# Signing keys (debug key + Play upload key and passwords): keep out of git, but BACK THEM UP
keystore/
