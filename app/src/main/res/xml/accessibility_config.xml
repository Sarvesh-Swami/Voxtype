<?xml version="1.0" encoding="utf-8"?>
<!-- Typing service, not an accessibility tool (isAccessibilityTool=false; declare this use in Play Console).
     flagInputMethodEditor (Android 13+) gives the service a keyboard-style input connection, so it can
     type live into any editor, including terminals like Termux. canRetrieveWindowContent is only used
     to find the focused input field when no input connection exists (Android 12 and older). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagInputMethodEditor"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100"
    android:settingsActivity="app.speaker.dictate.MainActivity"
    android:summary="@string/a11y_summary" />
