<resources>
    <!-- No system action bar: the app draws its own gradient header, edge-to-edge on Android 15+.
         MainActivity pads the layout for the status/navigation bars and keyboard. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>
</resources>
