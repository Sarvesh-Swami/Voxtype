<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <!-- Focusable root takes initial focus so the page doesn't jump to a text field. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <!-- ===== Header ===== -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="64dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="VoxType"
                        android:textColor="@color/on_brand"
                        android:textSize="28sp" />

                    <Button
                        android:id="@+id/btnUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill"
                        android:drawableStart="@drawable/ic_arrow_up"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/on_brand"
                        android:fontFamily="sans-serif-medium"
                        android:minWidth="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp"
                        android:stateListAnimator="@null"
                        android:text="Update"
                        android:textAllCaps="false"
                        android:textColor="@color/on_brand"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Voice typing for every app"
                    android:textColor="#D9FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="v0.0.0"
                    android:textColor="@color/on_brand"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ===== Dictate (overlaps the header) ===== -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="-44dp"
                android:elevation="6dp"
                android:gravity="center_horizontal"
                android:paddingTop="24dp">

                <ImageButton
                    android:id="@+id/btnTry"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_mic_idle"
                    android:contentDescription="Start or stop dictation"
                    android:elevation="4dp"
                    android:padding="26dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mic" />

                <TextView
                    android:id="@+id/txtTryStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tap to dictate"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtTryHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Try it here, or use the floating bubble in any app"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/txtResult"
                    style="@style/Field"
                    android:layout_marginTop="18dp"
                    android:gravity="top|start"
                    android:hint="Your words appear here as you speak"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnClear"
                        style="@style/ButtonTonal"
                        android:layout_marginEnd="8dp"
                        android:drawableStart="@drawable/ic_clear"
                        android:text="Clear" />

                    <Button
                        android:id="@+id/btnCopy"
                        style="@style/ButtonTonal"
                        android:drawableStart="@drawable/ic_copy"
                        android:text="Copy" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Setup checklist (hidden when everything is done) ===== -->
            <LinearLayout
                android:id="@+id/cardSetup"
                style="@style/Card">

                <LinearLayout style="@style/CardHeader">

                    <ImageView
                        style="@style/CardIcon"
                        android:src="@drawable/ic_shield" />

                    <TextView
                        style="@style/CardTitle"
                        android:text="Finish setup" />

                    <TextView
                        android:id="@+id/txtSetupProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="0 of 4"
                        android:textColor="@color/brand"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/setupRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ===== Floating bubble ===== -->
            <LinearLayout style="@style/Card">

                <LinearLayout style="@style/CardHeader">

                    <ImageView
                        style="@style/CardIcon"
                        android:src="@drawable/ic_bubble" />

                    <TextView
                        style="@style/CardTitle"
                        android:text="Floating bubble" />

                    <TextView
                        android:id="@+id/txtBubbleState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Off"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    style="@style/Body"
                    android:layout_marginTop="10dp"
                    android:text="A mic that floats over every app. Tap to start, tap again to stop. Drag to move, long-press to open VoxType. Also in your notification and Quick Settings (add the “Dictate” tile)." />

                <Button
                    android:id="@+id/btnBubble"
                    style="@style/ButtonPrimary"
                    android:layout_marginTop="16dp"
                    android:drawableStart="@drawable/ic_bubble"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Start floating bubble" />

                <Switch
                    android:id="@+id/swAutoType"
                    style="@style/SwitchRow"
                    android:layout_marginTop="12dp"
                    android:text="Type into the focused text field" />

                <Switch
                    android:id="@+id/swStopOnBlur"
                    style="@style/SwitchRow"
                    android:text="Stop when I leave the text field" />

                <Switch
                    android:id="@+id/swIsland"
                    style="@style/SwitchRow"
                    android:text="Show in the island / media controls (play = dictate, pause = stop)" />

                <Switch
                    android:id="@+id/swShowBubble"
                    style="@style/SwitchRow"
                    android:text="Show the floating bubble" />
            </LinearLayout>

            <!-- ===== Characters store (tiles are added in MainActivity.setupCharacters) ===== -->
            <LinearLayout style="@style/Card">

                <LinearLayout style="@style/CardHeader">

                    <ImageView
                        style="@style/CardIcon"
                        android:src="@drawable/ic_sparkle" />

                    <TextView
                        style="@style/CardTitle"
                        android:text="Characters" />

                    <TextView
                        android:id="@+id/txtSkinState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    style="@style/Body"
                    android:layout_marginTop="10dp"
                    android:text="Pick who floats over your apps. While you talk he takes his headphones off, opens his laptop and types. More characters are on the way." />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/rowSkins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ===== Speech engine ===== -->
            <LinearLayout style="@style/Card">

                <LinearLayout style="@style/CardHeader">

                    <ImageView
                        style="@style/CardIcon"
                        android:src="@drawable/ic_wave" />

                    <TextView
                        style="@style/CardTitle"
                        android:text="Speech engine" />
                </LinearLayout>

                <TextView
                    style="@style/Label"
                    android:text="ENGINE" />

                <Spinner
                    android:id="@+id/spnStt"
                    style="@style/SpinnerField" />

                <LinearLayout
                    android:id="@+id/rowSttModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Label"
                        android:text="MODEL" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/spnSttModel"
                            style="@style/SpinnerField"
                            android:layout_width="0dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/btnSttModels"
                            style="@style/ButtonTonal"
                            android:layout_marginStart="8dp"
                            android:contentDescription="Refresh the model list from the provider"
                            android:text="Refresh" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/edtSttModel"
                        style="@style/Field"
                        android:layout_marginTop="8dp"
                        android:hint="Type a model name"
                        android:inputType="text" />
                </LinearLayout>

                <TextView
                    style="@style/Label"
                    android:text="LANGUAGE" />

                <EditText
                    android:id="@+id/edtLanguage"
                    style="@style/Field"
                    android:hint="Auto-detect (or e.g. en, hi, en-IN)"
                    android:inputType="text" />
            </LinearLayout>

            <!-- ===== AI polish ===== -->
            <LinearLayout style="@style/Card">

                <LinearLayout style="@style/CardHeader">

                    <ImageView
                        style="@style/CardIcon"
                        android:src="@drawable/ic_sparkle" />

                    <Switch
                        android:id="@+id/swPolish"
                        style="@style/SwitchRow"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="AI rewrite"
                        android:textSize="17sp" />
                </LinearLayout>

                <TextView
                    style="@style/Body"
                    android:layout_marginTop="6dp"
                    android:text="Your words collect in a draft card next to the bubble. When you tap Send, the whole text goes to the AI with your prompt and the result is typed in. Save your own prompts and switch them here or from the bubble (long-press)." />

                <Button
                    android:id="@+id/btnEditPrompt"
                    style="@style/ButtonTonal"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:text="Prompt: Clean up · Edit" />

                <LinearLayout
                    android:id="@+id/polishOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Label"
                        android:text="PROVIDER" />

                    <Spinner
                        android:id="@+id/spnLlm"
                        style="@style/SpinnerField" />

                    <TextView
                        style="@style/Label"
                        android:text="MODEL" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/spnLlmModel"
                            style="@style/SpinnerField"
                            android:layout_width="0dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/btnLlmModels"
                            style="@style/ButtonTonal"
                            android:layout_marginStart="8dp"
                            android:contentDescription="Refresh the model list from the provider"
                            android:text="Refresh" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/edtLlmModel"
                        style="@style/Field"
                        android:layout_marginTop="8dp"
                        android:hint="Type a model name"
                        android:inputType="text" />

                    <TextView
                        style="@style/Label"
                        android:text="PROMPT IN USE" />

                    <EditText
                        android:id="@+id/edtPrompt"
                        style="@style/Field"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/swHistory"
                        style="@style/SwitchRow"
                        android:text="Keep recent dictations on this phone" />

                    <Button
                        android:id="@+id/btnHistory"
                        style="@style/ButtonTonal"
                        android:layout_width="match_parent"
                        android:layout_marginTop="8dp"
                        android:text="Recent dictations" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== API keys ===== -->
            <LinearLayout style="@style/Card">

                <LinearLayout style="@style/CardHeader">

                    <ImageView
                        style="@style/CardIcon"
                        android:src="@drawable/ic_key" />

                    <TextView
                        style="@style/CardTitle"
                        android:text="API keys" />
                </LinearLayout>

                <TextView
                    style="@style/Body"
                    android:layout_marginTop="10dp"
                    android:text="Stored only on this phone and sent only to the provider each key belongs to." />

                <LinearLayout
                    android:id="@+id/keysContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Label"
                    android:text="CUSTOM PROVIDER URL" />

                <EditText
                    android:id="@+id/edtCustomUrl"
                    style="@style/Field"
                    android:hint="https://my-server/v1"
                    android:inputType="textUri" />
            </LinearLayout>

            <!-- ===== Debug ===== -->
            <LinearLayout style="@style/Card">

                <LinearLayout style="@style/CardHeader">

                    <ImageView
                        style="@style/CardIcon"
                        android:src="@drawable/ic_code" />

                    <TextView
                        style="@style/CardTitle"
                        android:text="Logs &amp; debugging" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtLogsBody"
                    style="@style/Body"
                    android:layout_marginTop="10dp"
                    android:text="Logs stream live to the URL below (your PC). Blank = built-in URL, “off” = don't send." />

                <TextView
                    android:id="@+id/lblLogUrl"
                    style="@style/Label"
                    android:text="LOG URL" />

                <EditText
                    android:id="@+id/edtLogUrl"
                    style="@style/Field"
                    android:hint="https://your-log-server/log"
                    android:inputType="textUri" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTestLog"
                        style="@style/ButtonTonal"
                        android:layout_width="0dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Test" />

                    <Button
                        android:id="@+id/btnCopyLogs"
                        style="@style/ButtonTonal"
                        android:layout_width="0dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_copy"
                        android:text="Copy" />

                    <Button
                        android:id="@+id/btnShareLogs"
                        style="@style/ButtonTonal"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_share"
                        android:text="Share" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="VoxType"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="Privacy &amp; permissions"
                android:textColor="@color/brand"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
